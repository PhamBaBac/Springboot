# ==============================================================================
# KANBAN SERVICE - PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế của môi trường.
# LƯU Ý: Tuyệt đối KHÔNG commit file .env chứa giá trị thật lên Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH MÁY CHỦ (SERVER)
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU MYSQL (DATABASE)
# Production: Trỏ đến MySQL Cloud (AWS RDS, GCP Cloud SQL) hoặc IP/Container DB.
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/kanban?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & SESSION STORE
# Dùng để lưu OTP, OAuth2 exchange code, blacklist token, cart tạm thời.
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. MONGODB (LƯU LỊCH SỬ CHAT & TIN NHẮN HỖ TRỢ)
# Production: Sử dụng URI kết nối đầy đủ từ MongoDB Atlas.
# ------------------------------------------------------------------------------
PASSWORD_MONGODB=your_mongodb_password
MONGODB_URI=mongodb+srv://phambac:${PASSWORD_MONGODB}@cluster0.2rznse7.mongodb.net/chat?retryWrites=true&w=majority&appName=Cluster0

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH JPA / HIBERNATE (CỰC KỲ QUAN TRỌNG TRÊN PRODUCTION)
# - JPA_DDL_AUTO:
#     + Dev/Local: "update" (tự động cập nhật bảng)
#     + Production: BẮT BUỘC là "validate" hoặc "none" để tránh hỏng dữ liệu khi deploy!
# - SHOW_SQL:
#     + Dev: "true"
#     + Production: BẮT BUỘC là "false" để tối ưu hiệu năng và tránh lộ dữ liệu trong log.
# ------------------------------------------------------------------------------
JPA_DDL_AUTO=update
SHOW_SQL=false

# ------------------------------------------------------------------------------
# 6. BẢO MẬT & JWT TOKEN (JSON WEB TOKEN)
# - KEY_SECRET: Khóa bí mật ký JWT (Tối thiểu 256-bit / 32 ký tự ngẫu nhiên base64/hex).
# - JWT_EXPIRATION: Thời gian sống Access Token (milliseconds) - VD: 86400000 = 24h.
# - JWT_REFRESH_EXPIRATION: Thời gian sống Refresh Token - VD: 604800000 = 7 ngày.
# - COOKIE_SECURE:
#     + Local (HTTP): false
#     + Production (HTTPS): BẮT BUỘC là true để ngăn chặn rò rỉ cookie qua HTTP.
# ------------------------------------------------------------------------------
KEY_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 7. ĐĂNG NHẬP OAUTH2 (GOOGLE & GITHUB)
# Đăng ký thông tin tại:
# - Google Cloud Console: https://console.cloud.google.com/apis/credentials
# - GitHub Developer: https://github.com/settings/developers
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

# URL trang tiếp nhận callback trên Frontend (chuyển hướng sau khi xác thực OAuth2 thành công)
# Production: Thay bằng domain thực tế, ví dụ: https://yourdomain.com/auth/oauth-callback
OAUTH2_AUTHORIZED_REDIRECT_URI=http://localhost:3004/auth/oauth-callback

# ------------------------------------------------------------------------------
# 8. CẤU HÌNH GỬI EMAIL (SMTP)
# Dùng để gửi mã xác thực OTP kích hoạt tài khoản và đổi mật khẩu.
# LƯU Ý: Với Gmail, phải sử dụng "Mật khẩu ứng dụng" (App Password 16 ký tự).
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
EMAIL=your_email@gmail.com
PASS_EMAIL=your_16_digit_gmail_app_password

# ------------------------------------------------------------------------------
# 9. TÍCH HỢP TRÍ TUỆ NHÂN TẠO (GOOGLE GEMINI / OPENAI API)
# Dùng cho tính năng AI Chatbot, gợi ý sản phẩm và kiểm duyệt bình luận.
# Lấy API Key tại: https://aistudio.google.com/
# ------------------------------------------------------------------------------
OPEN_AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 10. CORS (CROSS-ORIGIN RESOURCE SHARING)
# Danh sách các domain frontend được phép gọi API (cách nhau bởi dấu phẩy).
# Production: Chỉ cho phép domain frontend chính thức (ví dụ: https://kanban.yourdomain.com).
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3004

# ------------------------------------------------------------------------------
# 11. CỔNG THANH TOÁN VNPAY (PAYMENT GATEWAY)
# Đăng ký tài khoản Sandbox hoặc Merchant chính thức tại VNPAY.
# ------------------------------------------------------------------------------
VNPAY_TMN_CODE=GE2X44LJ
VNPAY_HASH_SECRET=QNDE0P4SB43MO84431YBL17BXAZB5VIB
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payment/vnpay-return

# ------------------------------------------------------------------------------
# 12. GHI NHẬT KÝ HỆ THỐNG (LOGGING)
# Local: DEBUG hoặc INFO
# Production: INFO hoặc WARN (tránh rò rỉ thông tin nhạy cảm vào log)
# ------------------------------------------------------------------------------
LOG_LEVEL_SECURITY=INFO
